---
// src/layouts/LayoutDashboard.astro
import Asidebar  from '../components/Asidebar.astro';
interface Props {
  title: string;
}

const { title } = Astro.props;
import '../styles/global.css';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body class="flex min-h-screen">

    <Asidebar></Asidebar>
    <!-- Contenedor principal donde se inyecta el contenido del dashboard -->
    <div class="flex-1 flex flex-col min-w-0">
      <slot />
    </div>

  </body>
</html>