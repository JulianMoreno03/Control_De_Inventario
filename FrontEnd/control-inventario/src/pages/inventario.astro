---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
---

<Layout title="Control de Inventario - Dashboard">
  <main class="max-w-6xl mx-auto px-4 py-12">
    <header class="flex justify-between items-center mb-8">
      <div>
        <h1 class="text-3xl font-extrabold tracking-tight text-emerald-400 mb-1">
          Inventario General
        </h1>
        <p class="text-slate-400">Bienvenido al sistema. Aquí está el stock en tiempo real.</p>
      </div>
      <!-- Botón para cerrar sesión y volver al formulario -->
      <a href="/" class="bg-red-600/20 border border-red-500/50 text-red-400 hover:bg-red-600/30 px-4 py-2 rounded-lg text-sm transition">
        Cerrar Sesión
      </a>
    </header>

    <!-- Tu tabla de inventario aquí -->
    <section class="bg-slate-900 border border-slate-800 rounded-xl shadow-xl p-6">
      <h2 class="text-lg font-semibold text-slate-200 mb-4">Productos Registrados</h2>
      <p class="text-slate-400 text-sm">Cargando datos desde la API de Spring Boot...</p>
    </section>
  </main>
</Layout>