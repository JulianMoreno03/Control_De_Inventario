---
import '../styles/global.css';
---

<!-- Script que valida la sesión en el navegador -->
<script>
     import { navigate } from 'astro:transitions/client';
        
    const btnLogout = document.getElementById('btn-logout');
    if (btnLogout) {
        btnLogout.addEventListener('click', () => {
            // Borramos la sesión
            localStorage.removeItem('usuario');
            // Redirigimos al login
            navigate('/');
        });
    }
</script>
  <header class="flex justify-between items-center  ">
      <div>
        <h1 class="text-3xl font-extrabold  text-black mb-1">
          Bienvenido A Control de Inventario
        </h1>
      </div>
      
      <!-- Botón para cerrar sesión -->
      <button 
        id="btn-logout"
        class="bg-red-600/20 border border-red-500/50 text-red-400 hover:bg-red-600/30 px-4 py-2 rounded-lg text-sm transition cursor-pointer"
      >
        Cerrar Sesión
      </button>
    </header>
